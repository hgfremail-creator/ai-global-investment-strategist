# ─────────────────────────────────────────────────────────────────────────────
# AI Global Investment Strategist — environment template
# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required.
# Every key here is read SERVER-SIDE ONLY. Never prefix a secret with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (required) ---------------------------------------------------
# Dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"
# Production target (PostgreSQL) — see docker-compose.yml:
# DATABASE_URL="postgresql://strategist:strategist@localhost:5432/strategist?schema=public"
# DATABASE_PROVIDER="postgresql"

# --- Auth (required) ------------------------------------------------------
# 32+ random bytes, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"
# Session lifetime (seconds). Default 7 days.
AUTH_SESSION_MAX_AGE="604800"

# --- Weekly cron (required for scheduled refresh) --------------------------
# Bearer token expected by POST /api/cron/weekly-review
CRON_SECRET="replace-with-a-long-random-string"

# --- AI reasoning layer (optional) ---------------------------------------
# If unset, the app uses the deterministic fallback writer (clearly labelled).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Market data provider (optional; DemoProvider used if unset) ----------
MARKET_DATA_PROVIDER="demo"          # demo | fmp | alphavantage
FMP_API_KEY=""
ALPHAVANTAGE_API_KEY=""

# --- News provider (optional; DemoNewsProvider used if unset) -------------
NEWS_PROVIDER="demo"                 # demo | newsapi
NEWSAPI_KEY=""

# --- FX provider (optional; demo rates used if unset) --------------------
FX_PROVIDER="demo"                   # demo | exchangerate
EXCHANGERATE_API_KEY=""
