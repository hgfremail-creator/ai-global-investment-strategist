# ─────────────────────────────────────────────────────────────────────────────
# AI Global Investment Strategist — environment template
# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required.
# Every key here is read SERVER-SIDE ONLY. Never prefix a secret with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (required) ---------------------------------------------------
# Dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"
#
# Production / Vercel (PostgreSQL) — set these in the Vercel project env instead:
#   DATABASE_PROVIDER="postgresql"
#   DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
# (Vercel Postgres / Neon exposes this as POSTGRES_PRISMA_URL — copy it into DATABASE_URL.)
# `npm run build` then swaps the schema provider and runs `prisma db push`. See DEPLOY.md.
# Local Postgres for testing: docker-compose.yml.

# --- Auth (required) ------------------------------------------------------
# 32+ random bytes, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"
# Session lifetime (seconds). Default 7 days.
AUTH_SESSION_MAX_AGE="604800"

# --- Access mode (optional) ----------------------------------------------
# OPEN_ACCESS=true removes the auth gate entirely: every visitor lands directly
# on the dashboard sharing one ready-made portfolio (the seeded demo account).
# Leave unset for normal per-user accounts (register / login / "Enter — no signup").
# OPEN_ACCESS="true"

# --- Weekly cron (required for scheduled refresh) --------------------------
# Bearer token expected by /api/cron/weekly-review. On Vercel, setting this env
# var makes Vercel Cron send it automatically as `Authorization: Bearer <value>`.
CRON_SECRET="replace-with-a-long-random-string"

# --- AI reasoning layer (optional) ---------------------------------------
# If unset, the app uses the deterministic fallback writer (clearly labelled).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Market data provider (optional; demo provider used if unset) --------
# The concrete equity/fundamentals adapter is registered once a provider is
# chosen (see docs/DATA_SOURCES.md). Until then "demo" is authoritative.
MARKET_DATA_PROVIDER="demo"          # demo | (polygon|tiingo|eodhd|finnhub|twelvedata|fmp — tbd)
# POLYGON_API_KEY=""
# TIINGO_API_KEY=""
# FINNHUB_API_KEY=""
# TWELVEDATA_API_KEY=""
# FMP_API_KEY=""

# --- Macro provider (optional; FRED used automatically if FRED_API_KEY set) ---
# Free key: https://fredaccount.stlouisfed.org/apikeys
MACRO_PROVIDER="fred"                # fred | demo
FRED_API_KEY=""

# --- News provider (optional; demo provider used if unset) --------------
# Key: https://newsapi.org/register  (free tier is delayed / dev-only)
NEWS_PROVIDER="newsapi"              # newsapi | demo
NEWSAPI_KEY=""

# --- FX provider (optional; demo rates used if unset) --------------------
FX_PROVIDER="demo"                   # demo | exchangerate
EXCHANGERATE_API_KEY=""
